# Perfil Node/TypeScript web com Playwright.
FABER_CMD_LINT="npm run lint"
FABER_CMD_BUILD="npm run build"
FABER_CMD_TEST="npm test -- --run"
FABER_E2E="on"
FABER_CMD_E2E="npx playwright test --workers=1"
FABER_E2E_CMD_REGEX="playwright\S*\s+test\b"
FABER_E2E_SUMMARY_REGEX="\d+\s+passed\b"
FABER_E2E_FAIL_REGEX="\d+\s+failed\b"
FABER_SECRET_FILES=".env,.env.local,.env.production"
FABER_DESIGN_SYSTEM="on"
FABER_CMDS_CONFIRM="\bnpm\s+publish\b ;; \bdocker\s+push\b"
