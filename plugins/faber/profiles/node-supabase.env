# Perfil Node + Supabase (Postgres com RLS). Preencha os refs dos SEUS projetos
# remotos em FABER_REFS_DENY (produção) e FABER_REFS_CONFIRM
# (homologação) — qualquer comando contendo o ref de produção é negado pelo H1;
# o de homologação pede confirmação por execução.
FABER_CMD_LINT="npm run lint"
FABER_CMD_BUILD="npm run build"
FABER_CMD_TEST="npm run test:run"
FABER_E2E="on"
FABER_CMD_E2E="npx playwright test --project=chromium --workers=1"
FABER_MIGRATIONS_DIR="supabase/migrations"
FABER_MIGRATION_CHECKS="grant ,enable row level security,create policy,set search_path"
FABER_PROTECTED_PATHS="src/integrations/supabase/client.ts,src/integrations/supabase/types.ts"
FABER_SECRET_FILES=".env,.env.local,.env.admin"
FABER_REFS_DENY="<project-ref-de-PRODUCAO>"
FABER_REFS_CONFIRM="<project-ref-de-HOMOLOGACAO>"
# reset do banco só local: com --linked/--db-url é proibido
FABER_CMDS_DENY="\bdb\s+reset\b[^\n]*(--linked|--db-url)"
# operações que atingem o projeto remoto linkado exigem confirmação por execução
FABER_CMDS_CONFIRM="\bsupabase\b[^\n]*\bdb\s+push\b(?![^\n]*--local) ;; \bsupabase\b[^\n]*\blink\b ;; \bsupabase\b[^\n]*\bfunctions\s+deploy\b ;; \bsupabase\b[^\n]*\bsecrets\s+(set|unset)\b ;; \bsupabase\b[^\n]*\bconfig\s+push\b ;; \bsupabase\b[^\n]*\bmigration\s+repair\b"
FABER_LOCAL_ENV="on"
FABER_CMD_LOCAL_UP="supabase start"
FABER_CMD_LOCAL_STATUS="supabase status"
FABER_CMD_LOCAL_RESET="supabase db reset --local"
FABER_CMD_LOCAL_SEED="npm run db:seed:local"
FABER_CMD_LOCAL_STOP="supabase stop"
FABER_DESIGN_SYSTEM="on"
