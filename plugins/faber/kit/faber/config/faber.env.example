# =============================================================================
# faber.env — configuração da Fábrica de Software com Agentes (fonte única)
# Gerado por install.sh; edite à mão quando o projeto mudar. Formato KEY="valor"
# (lido por bash via `source` e por python via faber_config.py — mantenha
# UMA atribuição por linha, valores entre aspas duplas, sem expansões $).
# Listas: separadas por vírgula. Regex: separadas por " ;; ".
# =============================================================================

# ── Identidade ──────────────────────────────────────────────────────────────
FABER_PROJECT="Meu Projeto"           # nome legível do produto
FABER_OWNER="owner"                   # slug do aprovador humano (G1/G6/G8) — minúsculas, sem espaço
FABER_OWNER_NAME="Owner"              # nome de exibição do aprovador humano
FABER_LANG="pt-BR"                  # idioma de specs/issues/handoffs (pt-BR | en)

# ── Git ─────────────────────────────────────────────────────────────────────
FABER_REMOTE="origin"
FABER_TRUNK="develop"                 # branch de integração — PRs das demandas apontam para cá
FABER_MAIN="main"                     # branch de produção (só recebe promoção do trunk)
FABER_WORKTREES="on"                  # on = cada demanda roda em .claude/worktrees/TASK-XXX

# ── Modo de interação com o aprovador humano ────────────────────────────────
# gates        = o CTO encadeia todo o fluxo sozinho e só para nos gates humanos
#                (G1 · G6 · G8) e em `clarification` (dúvida crítica).
# step-by-step = o CTO para ao fim de cada comando/fase e pede ok para seguir.
FABER_INTERACTION="gates"

# ── GitHub (issues = ID da demanda; board Projects v2 opcional) ─────────────
FABER_GH="on"                         # on = issue por demanda (TASK-<issue#>); off = contador local
FABER_GH_REPO=""                      # owner/repo (vazio = descoberto do remote)
FABER_BOARD="off"                     # on = move cards no Projects v2 (exige gh com escopo project)
FABER_GH_PROJECT_TITLE=""            # título exato do Project v2 (quando FABER_BOARD=on)

# ── Specs (base canônica de conhecimento) ───────────────────────────────────
FABER_SPECS_DIR="specs"               # pasta com global/ e features/ (padrão RFC)

# ── Comandos de validação (G3 exige evidência de lint, build e test) ────────
FABER_CMD_LINT="npm run lint"
FABER_CMD_BUILD="npm run build"
FABER_CMD_TEST="npm run test"

# ── E2E (liga a exigência de E2E executado no G5 quando impacto_ui=true) ────
FABER_E2E="off"                       # on | off
FABER_CMD_E2E="npx playwright test"   # comando canônico (chamado DIRETO, sem pipe)
FABER_E2E_CMD_REGEX="playwright\S*\s+test\b"   # como o gate reconhece o comando que EXECUTA
FABER_E2E_SUMMARY_REGEX="\d+\s+passed\b"       # sumário de execução real do runner
FABER_E2E_FAIL_REGEX="\d+\s+failed\b"         # sumário com teste vermelho

# ── Banco / migrations (vazio = módulo desligado) ───────────────────────────
FABER_MIGRATIONS_DIR=""               # ex.: supabase/migrations · db/migrations · prisma/migrations
FABER_MIGRATION_CHECKS=""             # termos obrigatórios (H3), ex.: "grant ,enable row level security,create policy,set search_path"

# ── Guarda-vidas (H1/H2) ────────────────────────────────────────────────────
FABER_PROTECTED_PATHS=""             # deny de escrita: paths exatos ou prefixos (ex.: "src/generated/,schema.prisma")
FABER_SECRET_FILES=".env,.env.local"   # nomes de arquivo de secrets (deny de escrita; sempre por NOME)
FABER_REFS_DENY=""               # deny: qualquer comando contendo um destes tokens (ex.: ref de PROD)
FABER_REFS_CONFIRM=""               # ask: comando contendo um destes tokens (ex.: ref de HML)
FABER_CMDS_DENY=""               # ask/deny extra por regex, ex.: "\bterraform\s+apply\b ;; \bkubectl\s+delete\b"
FABER_CMDS_CONFIRM=""               # ex.: "\bdocker\s+push\b ;; \bnpm\s+publish\b ;; \bdb\s+push\b"

# ── Módulos opcionais ───────────────────────────────────────────────────────
FABER_SONAR="off"                     # on = Skill sonar-gate ativa (SONAR_TOKEN/SONAR_HOST_URL por nome)
FABER_SONAR_PROJECT_KEY=""            # projectKey do trunk no Sonar
FABER_LOCAL_ENV="off"                 # on = Skill local-env (ambiente local descartável)
FABER_CMD_LOCAL_UP=""                 # ex.: docker compose up -d
FABER_CMD_LOCAL_STATUS=""             # ex.: docker compose ps
FABER_CMD_LOCAL_RESET=""              # ex.: docker compose down -v && docker compose up -d && npm run db:migrate
FABER_CMD_LOCAL_SEED=""               # ex.: npm run db:seed
FABER_CMD_LOCAL_STOP=""               # ex.: docker compose down
FABER_DESIGN_SYSTEM="off"             # on = Skill design-system-check (grep de cor hardcoded — Tailwind)
FABER_DASHBOARD="off"                 # on = faber/dashboard instalado (Kanban local, Flask)
